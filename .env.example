# Copy to .env and adjust. Every value except the token has a default in compose.yaml.

# Postgres (internal only, no published port)
POSTGRES_USER=biss
POSTGRES_PASSWORD=biss
POSTGRES_DB=biss

# Default daily goals, used while no goal is stored
GOAL_KCAL=2400
GOAL_PROTEIN=160
GOAL_CARBS=260
GOAL_FAT=75

# Web: API behind the /api/v1 rewrite (compose service name inside the stack)
API_URL=http://api:2478

# Label extraction (E4, ADR-0004): token from `claude setup-token`, or an API key instead
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_STRONG=claude-sonnet-5-5

# Optional: compose project name, e.g. for a second stack next to the main one
# COMPOSE_PROJECT_NAME=biss
